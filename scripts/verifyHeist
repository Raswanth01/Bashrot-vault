#!/bin/bash
# 1. Warden Check
if ! groups $USER | grep -q "\bwardens\b"; then
    echo "Access Denied: You do not have the Aura of a Warden."
    exit 1
fi

SLANG_FILE="/scripts/slang.txt"
LOG_FILE="/var/log/heist.log"

# 2. Monitor all Drop_Zones
# This path looks into each basher's personal Drop_Zone
for zone in /home/bashers/*/Drop_Zone; do
    shopt -s nullglob
    for file in "$zone"/*; do
        
        # Get the basher's name from the path (the 4th segment)
        basher_name=$(echo "$file" | cut -d'/' -f4)
        
        # Read content and strip whitespace
        content=$(cat "$file" 2>/dev/null | tr -d '[:space:]')

        # 3. Validation: Does it match the slang list?
        if grep -Fqx "$content" "$SLANG_FILE"; then

            # 4. Broadcast Success to everyone logged in
            MESSAGE="🚨 HEIST SUCCESS: Basher [$basher_name] has stolen the lore: '$content'!"
            echo "$MESSAGE" | wall

            # 5. Log the metadata
            echo "$(date '+%Y-%m-%d %H:%M:%S') | Basher: $basher_name | Content: $content" >> "$LOG_FILE"

            # 6. Cleanup (The Warden 'seizes' the evidence)
            # We use -f so it doesn't ask permission
            rm -f "$file"
        fi
    done
done
