#!/bin/bash
# cryptographic core - background service

SLANG="/home/raswanth/slang.txt"
VAULT="/opt/Bashrot_vault/.secret_tunnel"
# Define cringe words to be jammed
BAD_WORDS=("skibidi" "gyatt" "fanum") 

while true; do
    # 1. Select exactly one random word from slang.txt
    WORD=$(shuf -n 1 "$SLANG" | tr -d '[:space:]')
    
    # 2. Use sed to replace bad words with asterisks of same length
    # This loop applies sed for each bad word defined above
    CLEAN_WORD="$WORD"
    for BAD in "${BAD_WORDS[@]}"; do
        # Generate a string of asterisks equal to the bad word's length
        STARS=$(echo -n "$BAD" | sed 's/./*/g')
        # Use sed to swap the word if it matches
        CLEAN_WORD=$(echo "$CLEAN_WORD" | sed "s/$BAD/$STARS/g")
    done

    # 3. Encode the (potentially cleaned) word using Base64
    ENCODED=$(echo -n "$CLEAN_WORD" | base64)
    
    # 4. Save into a newly generated file and dump to vault
    FILENAME="lore_$(date +%s).txt"
    echo "$ENCODED" > "$VAULT/$FILENAME"
    
    # 5. Maintain operational standards (Background Service Timing)
    sleep 30
done
