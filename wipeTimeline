#!/bin/bash

if [[ $EUID -ne 0 ]]; then
   echo "This script must be run with sudo (Admin only)." 
   exit 1
fi

echo "⚠️  INITIATING WIPE_TIMELINE PROTOCOL..."

# 1. Terminate Generator
pkill -f generateLore && echo "[+] generateLore terminated."

# 2. Wipe Basher Directories (Keep the structure)
for dir in /home/bashers/*; do
    if [ -d "$dir" ]; then
        # Delete contents but keep the directory and Drop_Zone
        find "$dir" -mindepth 1 -maxdepth 1 ! -name 'Drop_Zone' ! -name '.*' -exec rm -rf {} +
        rm -rf "$dir/Drop_Zone"/*
        echo "[+] Wiped $dir"
    fi
done

# 3. Reset Vault & ACLs
rm -rf /opt/Bashrot_vault/.secret_tunnel/*
setfacl -b -R /opt/Bashrot_vault  # Remove all ACLs
chmod 700 /opt/Bashrot_vault       # Reset to default secure state
chown root:root /opt/Bashrot_vault

# 4. Clear Logs
> /var/log/heist.log
> /var/log/leaderboard.log

echo "✨ SIMULATION RESET COMPLETE. Ready for next round."
